<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="12dp">

    <View
        android:id="@+id/view_type_indicator"
        android:layout_width="4dp"
        android:layout_height="36dp"
        android:background="@color/secondary_container"
        android:layout_marginEnd="12dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_txn_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Payment"
            android:textColor="@color/on_surface"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_txn_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Monthly settlement"
            android:textColor="@color/outline"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/tv_txn_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="+₹500"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_txn_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="May 9, 2026"
            android:textColor="@color/outline"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>
</LinearLayout>
